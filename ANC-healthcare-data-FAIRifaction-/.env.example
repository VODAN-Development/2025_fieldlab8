# ============================================
# JAVA
# ============================================

# Path to your local JDK installation
JAVA_HOME=/path/to/jdk

# ============================================
# H2 DATABASE
# ============================================

# Path to the H2 database JAR
H2_JAR_PATH=./h2/h2-2.4.240.jar

# ============================================
# ONTOP
# ============================================

# Path to the Ontop installation directory
ONTOP_DIR=./ontop

# ============================================
# ALLEGROGRAPH
# ============================================

# ---------- CHU Repository ----------
AG_USER_CHU=admin
AG_PASSWORD_CHU=your_chu_password
AG_BASE_URL_CHU=https://your-server.allegrograph.cloud
AG_REPO_CHU=CHU

# ---------- Hospital Repository ----------
AG_USER_HOSPITAL=admin
AG_PASSWORD_HOSPITAL=your_hospital_password
AG_BASE_URL_HOSPITAL=https://your-server.allegrograph.cloud
AG_REPO_HOSPITAL=Hospital