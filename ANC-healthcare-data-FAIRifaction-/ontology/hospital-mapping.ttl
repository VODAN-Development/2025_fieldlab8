@prefix : <https://w3id.org/dhs/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:FacilityRegisterMapping> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery """SELECT MFL_CODE, HEALTH_FACILITY, SERVICE_DELIVERY_POINT, COUNTY, SUB_COUNTY
FROM FACILITY_REGISTER"""
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "MFL_CODE";
          rr:termType rr:Literal
        ];
      rr:predicate :hasMFLCode
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "HEALTH_FACILITY";
          rr:termType rr:Literal
        ];
      rr:predicate :hasFacilityName
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "SERVICE_DELIVERY_POINT";
          rr:termType rr:Literal
        ];
      rr:predicate :hasServiceDeliveryPoint
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "COUNTY";
          rr:termType rr:Literal
        ];
      rr:predicate :hasCHUCounty
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "SUB_COUNTY";
          rr:termType rr:Literal
        ];
      rr:predicate :hasCHUSubCounty
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:class :Facility;
      rr:template "https://w3id.org/dhs/ontology#Facility_{MFL_CODE}";
      rr:termType rr:IRI
    ] .

<urn:ANC_ClientMapping> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery """SELECT NUPI, ANC_NUMBER,
CASE WHEN LOCATE(' ', FULL_NAME) = 0 THEN FULL_NAME
ELSE SUBSTRING(FULL_NAME, 1, LOCATE(' ', FULL_NAME) - 1) END AS FIRST_NAME,
CASE WHEN LOCATE(' ', FULL_NAME) = 0 THEN ''
ELSE SUBSTRING(FULL_NAME, LOCATE(' ', FULL_NAME) + 1) END AS LAST_NAME,
DATE_OF_BIRTH, PHONE_NUMBER, MARITAL_STATUS
FROM ANC_CLIENT"""
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "NUPI";
          rr:termType rr:Literal
        ];
      rr:predicate :hasUPINumber
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "ANC_NUMBER";
          rr:termType rr:Literal
        ];
      rr:predicate :hasANCNumber
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "FIRST_NAME";
          rr:termType rr:Literal
        ];
      rr:predicate :hasFirstName
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "LAST_NAME";
          rr:termType rr:Literal
        ];
      rr:predicate :hasLastName
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "DATE_OF_BIRTH";
          rr:termType rr:Literal
        ];
      rr:predicate :hasDateOfBirth
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "PHONE_NUMBER";
          rr:termType rr:Literal
        ];
      rr:predicate :hasPhoneNumber
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "MARITAL_STATUS";
          rr:termType rr:Literal
        ];
      rr:predicate :hasMaritalStatus
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:class :Patient;
      rr:template "https://w3id.org/dhs/ontology#Patient_{NUPI}";
      rr:termType rr:IRI
    ] .

<urn:PregnancyDetailsMapping-197bc269-fdd3-4476-8157-a5e3a0ee7143> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery """SELECT
pd.ANC_NUMBER,
pd.PARITY,
pd.GRAVIDAE,
pd.LMP,
pd.EDD,
pd.GESTATION_WEEKS,
av.VISIT_ID
FROM PREGNANCY_DETAILS pd
JOIN ANC_VISIT av
ON pd.ANC_NUMBER = av.ANC_NUMBER"""
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "PARITY";
          rr:termType rr:Literal
        ];
      rr:predicate :hasPara
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "GRAVIDAE";
          rr:termType rr:Literal
        ];
      rr:predicate :hasGravida
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "LMP";
          rr:termType rr:Literal
        ];
      rr:predicate :hasLMPDate
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "EDD";
          rr:termType rr:Literal
        ];
      rr:predicate :hasExpectedDeliveryDate
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "GESTATION_WEEKS";
          rr:termType rr:Literal
        ];
      rr:predicate :hasGestationAgeWeeks
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:class :MaternalProfile;
      rr:template "https://w3id.org/dhs/ontology#MaternalProfile_{ANC_NUMBER}";
      rr:termType rr:IRI
    ] .

