<urn:LinkingMapping> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery """SELECT c.INDIVIDUAL_ID, ac.NUPI
FROM CLIENT c
JOIN ANC_CLIENT ac ON c.FULL_NAME = ac.FULL_NAME AND c.DATE_OF_BIRTH = ac.DATE_OF_BIRTH"""
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:template "https://w3id.org/dhs/ontology#Patient_{NUPI}";
          rr:termType rr:IRI
        ];
      rr:predicate :hasCorrespondingPatient
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:template "https://w3id.org/dhs/ontology#Client_{INDIVIDUAL_ID}";
      rr:termType rr:IRI
    ] .

<urn:PregnancyLinkMapping> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery """SELECT mch.MCH_ID, pd.ANC_NUMBER
FROM MATERNAL_CHILD_HEALTH mch
JOIN CLIENT c ON mch.INDIVIDUAL_ID = c.INDIVIDUAL_ID
JOIN ANC_CLIENT ac ON c.FULL_NAME = ac.FULL_NAME AND c.DATE_OF_BIRTH = ac.DATE_OF_BIRTH
JOIN ANC_VISIT av ON av.NUPI = ac.NUPI
JOIN PREGNANCY_DETAILS pd ON pd.ANC_NUMBER = av.ANC_NUMBER
WHERE ABS(DATEDIFF('DAY', pd.EDD, mch.EXPECTED_DELIVERY_DATE)) <= 14"""
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:template "https://w3id.org/dhs/ontology#MaternalProfile_{ANC_NUMBER}";
          rr:termType rr:IRI
        ];
      rr:predicate :hasCorrespondingPregnancy
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:template "https://w3id.org/dhs/ontology#MaternalChildHealth_{MCH_ID}";
      rr:termType rr:IRI
    ] .

<urn:ReferralLinkMapping> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery """SELECT r.REFERRAL_ID, hr.ANC_NUMBER
FROM REFERRAL r
JOIN CLIENT c ON r.INDIVIDUAL_ID = c.INDIVIDUAL_ID
JOIN ANC_CLIENT ac ON c.FULL_NAME = ac.FULL_NAME AND c.DATE_OF_BIRTH = ac.DATE_OF_BIRTH
JOIN ANC_VISIT av ON av.NUPI = ac.NUPI
JOIN HOSPITAL_REFERRAL hr ON hr.ANC_NUMBER = av.ANC_NUMBER
WHERE ABS(DATEDIFF('DAY', av.DATE_OF_VISIT, r.REFERRAL_DATE)) <= 7"""
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:template "https://w3id.org/dhs/ontology#Referral_{ANC_NUMBER}";
          rr:termType rr:IRI
        ];
      rr:predicate :hasCorrespondingReferral
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:template "https://w3id.org/dhs/ontology#CHU_Referral_{REFERRAL_ID}";
      rr:termType rr:IRI
    ] .

<urn:SyphilisLinkMapping> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery """SELECT hs.RECORD_ID, lr.ANC_NUMBER
FROM HEALTH_SURVEILLANCE hs
JOIN CLIENT c ON hs.INDIVIDUAL_ID = c.INDIVIDUAL_ID
JOIN ANC_CLIENT ac ON c.FULL_NAME = ac.FULL_NAME AND c.DATE_OF_BIRTH = ac.DATE_OF_BIRTH
JOIN ANC_VISIT av ON av.NUPI = ac.NUPI
JOIN LABORATORY_RESULTS lr ON lr.ANC_NUMBER = av.ANC_NUMBER
WHERE (LOWER(hs.SYMPTOM) LIKE '%syphilis%' OR LOWER(hs.DIAGNOSIS) LIKE '%syphilis%'
    OR LOWER(hs.DANGER_SIGNS) LIKE '%syphilis%' OR LOWER(hs.DANGER_SIGNS) LIKE '%sexual%'
    OR LOWER(hs.DANGER_SIGNS) LIKE '%assault%' OR LOWER(hs.DANGER_SIGNS) LIKE '%gbv%')
AND LOWER(lr.RPR_VDRL_DUO_TEST_RESULT) = 'positive'"""
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:template "https://w3id.org/dhs/ontology#HIVCareRecord_{ANC_NUMBER}";
          rr:termType rr:IRI
        ];
      rr:predicate :hasCorrespondingSyphilisRecord
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:template "https://w3id.org/dhs/ontology#HealthSurveillance_{RECORD_ID}";
      rr:termType rr:IRI
    ] .

<urn:ReferredFacilityLinkMapping> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery """SELECT r.REFERRAL_ID, fr.MFL_CODE
FROM REFERRAL r
JOIN FACILITY_REGISTER fr ON r.FACILITY_REFERRED_TO = fr.HEALTH_FACILITY"""
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:template "https://w3id.org/dhs/ontology#Facility_{MFL_CODE}";
          rr:termType rr:IRI
        ];
      rr:predicate :referredToFacility
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:template "https://w3id.org/dhs/ontology#CHU_Referral_{REFERRAL_ID}";
      rr:termType rr:IRI
    ] .