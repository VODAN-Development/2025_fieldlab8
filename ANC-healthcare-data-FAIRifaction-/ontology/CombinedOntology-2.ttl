@prefix : <https://w3id.org/dhs/ontology#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix map: <https://w3id.org/dhs/mapping#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fhir: <http://hl7.org/fhir/StructureDefinition/> .
@prefix obda: <https://w3id.org/obda/vocabulary#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix loinc: <http://loinc.org/rdf/> .
@prefix schema: <https://schema.org/> .
@prefix snomed: <http://snomed.info/id/> .
@base <https://w3id.org/dhs/ontology#> .

<https://w3id.org/dhs/ontology> rdf:type owl:Ontology ;
                                 dct:created "2026-05-15"^^xsd:date ;
                                 dct:creator """Lina Dadić
Arya Deshmukh""" ;
                                 dct:description "Ontology supporting semantic interoperability and FAIRification of antenatal care electronic medical record systems across federated Kenyan healthcare institutions."@en ;
                                 dct:language "en" ;
                                 dct:license <https://creativecommons.org/licenses/by/4.0/> ;
                                 dct:title "Federated ANC EMR Ontology for Mutuini and Mathare Hospitals; KCEI community health centre and Pumwani hospital"@en ;
                                 owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dct:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dct:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dct:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/language
dct:language rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dct:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dct:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#time
xsd:time rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/dhs/ontology#assignedToDepartment
:assignedToDepartment rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasDepartment ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :Consultation
                                                  :Provider
                                                  :Visit
                                                )
                                  ] ;
                      rdfs:range :Department .


###  https://w3id.org/dhs/ontology#belongsToDepartment
:belongsToDepartment rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasDepartment ;
                     owl:inverseOf :isDepartmentOf ;
                     rdfs:range :Department .


###  https://w3id.org/dhs/ontology#belongsToFacility
:belongsToFacility rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasFacility ;
                   owl:inverseOf :isFacilityOf ;
                   rdfs:domain :Department ;
                   rdfs:range :Facility .


###  https://w3id.org/dhs/ontology#createsClinicalRecord
:createsClinicalRecord rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :isProviderOf ;
                       owl:inverseOf :isCreatedByProvider ;
                       rdfs:domain :Provider ;
                       rdfs:range :ClinicalRecord .


###  https://w3id.org/dhs/ontology#dispensesMedication
:dispensesMedication rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :isProviderOf ;
                     owl:inverseOf :isDispensedByProvider ;
                     rdfs:domain :Provider ;
                     rdfs:range :MedicationDispense .


###  https://w3id.org/dhs/ontology#fromDepartment
:fromDepartment rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasDepartment ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :PatientFlow
                                            :Referral
                                            :Transfer
                                          )
                            ] ;
                rdfs:range :Department .


###  https://w3id.org/dhs/ontology#fromFacility
:fromFacility rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasFacility ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Referral
                                          :Transfer
                                        )
                          ] ;
              rdfs:range :Facility .


###  https://w3id.org/dhs/ontology#hasAdmission
:hasAdmission rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasEncounter ;
              owl:inverseOf :isAdmissionOf ;
              rdfs:domain :Visit ;
              rdfs:range :Admission .


###  https://w3id.org/dhs/ontology#hasAllergenCode
:hasAllergenCode rdf:type owl:ObjectProperty ;
                 rdfs:domain :Allergy ;
                 rdfs:range :Allergen .


###  https://w3id.org/dhs/ontology#hasAllergy
:hasAllergy rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasClinicalRecord ;
            owl:inverseOf :isAllergyOf ;
            rdfs:domain :Visit ;
            rdfs:range :Allergy .


###  https://w3id.org/dhs/ontology#hasBloodGroupCode
:hasBloodGroupCode rdf:type owl:ObjectProperty ;
                   rdfs:domain :MaternalProfile ;
                   rdfs:range :BloodGroup .


###  https://w3id.org/dhs/ontology#hasClient
:hasClient rdf:type owl:ObjectProperty ;
           rdfs:domain :HouseholdRegistration ;
           rdfs:range :Client ;
           rdfs:comment "Relates a household registration record to an individual registered as a member of that household." ;
           rdfs:label "has client" .


###  https://w3id.org/dhs/ontology#hasClientReferral
:hasClientReferral rdf:type owl:ObjectProperty ;
                   rdfs:domain :Client ;
                   rdfs:range :CHU_Referral ;
                   rdfs:comment "Relates a client to a CHU referral record documenting a transfer or recommendation for healthcare services at another facility or provider."@en ;
                   rdfs:label "has client referral"@en .


###  https://w3id.org/dhs/ontology#hasClinicalAssessment
:hasClinicalAssessment rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasEncounter ;
                       owl:inverseOf :isClinicalAssessmentOf ;
                       rdfs:domain :Visit ;
                       rdfs:range :ClinicalAssessment .


###  https://w3id.org/dhs/ontology#hasClinicalNote
:hasClinicalNote rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasClinicalRecord ;
                 owl:inverseOf :isClinicalNoteOf ;
                 rdfs:domain :Visit ;
                 rdfs:range :ClinicalNote .


###  https://w3id.org/dhs/ontology#hasClinicalRecord
:hasClinicalRecord rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasEncounter ;
                   owl:inverseOf :isClinicalRecordOf ;
                   rdfs:domain :Visit ;
                   rdfs:range :ClinicalRecord .


###  https://w3id.org/dhs/ontology#hasComplaintExam
:hasComplaintExam rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasClinicalRecord ;
                  owl:inverseOf :isComplaintExamOf ;
                  rdfs:domain :Visit ;
                  rdfs:range :ComplaintExam .


###  https://w3id.org/dhs/ontology#hasConsultation
:hasConsultation rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasEncounter ;
                 owl:inverseOf :isConsultationOf ;
                 rdfs:domain :Visit ;
                 rdfs:range :Consultation .


###  https://w3id.org/dhs/ontology#hasCorrespondingPatient
:hasCorrespondingPatient rdf:type owl:ObjectProperty ;
                         rdfs:domain :Client ;
                         rdfs:range :Patient ;
                         rdfs:comment "Relates a CHU client record to the corresponding hospital patient record, resolved via name and date-of-birth matching in the absence of a shared identifier (see thesis Chapter 8)."@en ;
                         rdfs:label "has corresponding patient"@en .


###  https://w3id.org/dhs/ontology#hasCorrespondingPregnancy
:hasCorrespondingPregnancy rdf:type owl:ObjectProperty ;
                           rdfs:domain :MaternalChildHealth ;
                           rdfs:range :MaternalProfile .


###  https://w3id.org/dhs/ontology#hasCorrespondingReferral
:hasCorrespondingReferral rdf:type owl:ObjectProperty ;
                          rdfs:domain :CHU_Referral ;
                          rdfs:range :Referral .


###  https://w3id.org/dhs/ontology#hasCorrespondingSyphilisRecord
:hasCorrespondingSyphilisRecord rdf:type owl:ObjectProperty ;
                                rdfs:domain :HealthSurveillance ;
                                rdfs:range :HIVCareRecord .


###  https://w3id.org/dhs/ontology#hasDepartment
:hasDepartment rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :relatesToDepartment .


###  https://w3id.org/dhs/ontology#hasDepartmentTypeCode
:hasDepartmentTypeCode rdf:type owl:ObjectProperty ;
                       rdfs:domain :Department ;
                       rdfs:range :DepartmentType .


###  https://w3id.org/dhs/ontology#hasDiagnosis
:hasDiagnosis rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasClinicalRecord ;
              owl:inverseOf :isDiagnosisOf ;
              rdfs:domain :Visit ;
              rdfs:range :Diagnosis .


###  https://w3id.org/dhs/ontology#hasDiagnosisTypeCode
:hasDiagnosisTypeCode rdf:type owl:ObjectProperty ;
                      rdfs:domain :Diagnosis ;
                      rdfs:range :DiagnosisType .


###  https://w3id.org/dhs/ontology#hasEncounter
:hasEncounter rdf:type owl:ObjectProperty .


###  https://w3id.org/dhs/ontology#hasEnvironmentalWASH
:hasEnvironmentalWASH rdf:type owl:ObjectProperty ;
                      rdfs:domain :HouseholdRegistration ;
                      rdfs:range :EnvironmentalWASH ;
                      rdfs:comment "Relates a household registration record to an environmental, water, sanitation, hygiene, and waste management assessment." ;
                      rdfs:label "has environmental and WASH assessment" .


###  https://w3id.org/dhs/ontology#hasFacility
:hasFacility rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :relatesToFacility .


###  https://w3id.org/dhs/ontology#hasGenderCode
:hasGenderCode rdf:type owl:ObjectProperty ;
               rdfs:domain :Patient ;
               rdfs:range :Gender .


###  https://w3id.org/dhs/ontology#hasHIVCareRecord
:hasHIVCareRecord rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasClinicalAssessment ;
                  owl:inverseOf :isHIVCareRecordOf ;
                  rdfs:domain :Visit ;
                  rdfs:range :HIVCareRecord .


###  https://w3id.org/dhs/ontology#hasHIVStatusCode
:hasHIVStatusCode rdf:type owl:ObjectProperty ;
                  rdfs:domain :HIVTestingRecord ;
                  rdfs:range :HIVStatus .


###  https://w3id.org/dhs/ontology#hasHIVTestingRecord
:hasHIVTestingRecord rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasClinicalAssessment ;
                     owl:inverseOf :isHIVTestingRecordOf ;
                     rdfs:domain :Visit ;
                     rdfs:range :HIVTestingRecord .


###  https://w3id.org/dhs/ontology#hasHealthSurveillance
:hasHealthSurveillance rdf:type owl:ObjectProperty ;
                       rdfs:domain :Client ;
                       rdfs:range :HealthSurveillance ;
                       rdfs:comment "Relates a client to a health surveillance record containing observed health conditions, symptoms, risk factors, or health status information." ;
                       rdfs:label "has health surveillance" .


###  https://w3id.org/dhs/ontology#hasHouseholdRegistration
:hasHouseholdRegistration rdf:type owl:ObjectProperty ;
                          rdfs:domain :CommunityHealthUnit ;
                          rdfs:range :HouseholdRegistration ;
                          rdfs:comment "Relates a Community Health Unit to a household registration record within its area of responsibility." ;
                          rdfs:label "has household registration" .


###  https://w3id.org/dhs/ontology#hasICDCodeCode
:hasICDCodeCode rdf:type owl:ObjectProperty ;
                rdfs:domain :Diagnosis ;
                rdfs:range :ICDCode .


###  https://w3id.org/dhs/ontology#hasLaboratoryResult
:hasLaboratoryResult rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasClinicalAssessment ;
                     owl:inverseOf :isLaboratoryResultOf ;
                     rdfs:domain :Visit ;
                     rdfs:range :LaboratoryResult .


###  https://w3id.org/dhs/ontology#hasManagementPlan
:hasManagementPlan rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasClinicalRecord ;
                   owl:inverseOf :isManagementPlanOf ;
                   rdfs:domain :Visit ;
                   rdfs:range :ManagementPlan .


###  https://w3id.org/dhs/ontology#hasMaternalChildHealth
:hasMaternalChildHealth rdf:type owl:ObjectProperty ;
                        rdfs:domain :Client ;
                        rdfs:range :MaternalChildHealth ;
                        rdfs:comment "Relates a client to a maternal and child health record containing pregnancy, antenatal, delivery, postnatal, immunization, or growth monitoring information." ;
                        rdfs:label "has maternal and child health record" .


###  https://w3id.org/dhs/ontology#hasMaternalChildHealthRecord
:hasMaternalChildHealthRecord rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :hasClinicalAssessment ;
                              owl:inverseOf :isMaternalChildHealthRecordOf ;
                              rdfs:domain :Visit ;
                              rdfs:range :MaternalChildHealthRecord .


###  https://w3id.org/dhs/ontology#hasMaternalProfile
:hasMaternalProfile rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasClinicalRecord ;
                    owl:inverseOf :isMaternalProfileOf ;
                    rdfs:domain :Visit ;
                    rdfs:range :MaternalProfile .


###  https://w3id.org/dhs/ontology#hasMedication
:hasMedication rdf:type owl:ObjectProperty ;
               owl:inverseOf :isMedicationOf ;
               rdfs:domain :MedicationDispense ;
               rdfs:range :Medication .


###  https://w3id.org/dhs/ontology#hasMedicationDispense
:hasMedicationDispense rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasEncounter ;
                       owl:inverseOf :isMedicationDispenseOf ;
                       rdfs:domain :Visit ;
                       rdfs:range :MedicationDispense .


###  https://w3id.org/dhs/ontology#hasMentalHealthAssessment
:hasMentalHealthAssessment rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :hasClinicalAssessment ;
                           owl:inverseOf :isMentalHealthAssessmentOf ;
                           rdfs:domain :Visit ;
                           rdfs:range :MentalHealthAssessment .


###  https://w3id.org/dhs/ontology#hasNutritionAssessment
:hasNutritionAssessment rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :hasClinicalAssessment ;
                        owl:inverseOf :isNutritionAssessmentOf ;
                        rdfs:domain :Visit ;
                        rdfs:range :NutritionAssessment .


###  https://w3id.org/dhs/ontology#hasPatient
:hasPatient rdf:type owl:ObjectProperty ;
            owl:inverseOf :isPatientIn ;
            rdfs:domain :Visit ;
            rdfs:range :Patient .


###  https://w3id.org/dhs/ontology#hasPatientFlow
:hasPatientFlow rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasEncounter ;
                owl:inverseOf :isPatientFlowOf ;
                rdfs:domain :Visit ;
                rdfs:range :PatientFlow .


###  https://w3id.org/dhs/ontology#hasProvider
:hasProvider rdf:type owl:ObjectProperty ;
             owl:inverseOf :isProviderOf ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :ClinicalAssessment
                                         :ClinicalRecord
                                         :Consultation
                                         :MedicationDispense
                                       )
                         ] ;
             rdfs:range :Provider .


###  https://w3id.org/dhs/ontology#hasReferral
:hasReferral rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasEncounter ;
             owl:inverseOf :isReferralOf ;
             rdfs:domain :Visit ;
             rdfs:range :Referral .


###  https://w3id.org/dhs/ontology#hasRehabilitationAssessment
:hasRehabilitationAssessment rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :hasClinicalAssessment ;
                             owl:inverseOf :isRehabilitationAssessmentOf ;
                             rdfs:domain :Visit ;
                             rdfs:range :RehabilitationAssessment .


###  https://w3id.org/dhs/ontology#hasRhesusFactorCode
:hasRhesusFactorCode rdf:type owl:ObjectProperty ;
                     rdfs:domain :MaternalProfile ;
                     rdfs:range :RhesusFactor .


###  https://w3id.org/dhs/ontology#hasServiceDelivery
:hasServiceDelivery rdf:type owl:ObjectProperty ;
                    rdfs:domain :Client ;
                    rdfs:range :ServiceDelivery ;
                    rdfs:comment "Relates a client to a healthcare service or intervention delivered within the community." ;
                    rdfs:label "has service delivery" .


###  https://w3id.org/dhs/ontology#hasTBScreening
:hasTBScreening rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasClinicalRecord ;
                owl:inverseOf :isTBScreeningOf ;
                rdfs:domain :Visit ;
                rdfs:range :TBScreening .


###  https://w3id.org/dhs/ontology#hasTransfer
:hasTransfer rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasEncounter ;
             owl:inverseOf :isTransferOf ;
             rdfs:domain :Visit ;
             rdfs:range :Transfer .


###  https://w3id.org/dhs/ontology#hasTriageAssessment
:hasTriageAssessment rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasClinicalAssessment ;
                     owl:inverseOf :isTriageAssessmentOf ;
                     rdfs:domain :Visit ;
                     rdfs:range :TriageAssessment .


###  https://w3id.org/dhs/ontology#hasVisit
:hasVisit rdf:type owl:ObjectProperty ;
          owl:inverseOf :isVisitOf ;
          rdfs:domain :Patient ;
          rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#hasVitalSignsRecord
:hasVitalSignsRecord rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasClinicalAssessment ;
                     owl:inverseOf :isVitalSignsRecordOf ;
                     rdfs:domain :Visit ;
                     rdfs:range :VitalSignsRecord .


###  https://w3id.org/dhs/ontology#isAdmissionOf
:isAdmissionOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isEncounterOf ;
               rdfs:domain :Admission ;
               rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isAllergyOf
:isAllergyOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :isClinicalRecordOf ;
             rdfs:domain :Allergy ;
             rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isClinicalAssessmentOf
:isClinicalAssessmentOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :isEncounterOf .


###  https://w3id.org/dhs/ontology#isClinicalNoteOf
:isClinicalNoteOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :isClinicalRecordOf ;
                  rdfs:domain :ClinicalNote ;
                  rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isClinicalRecordOf
:isClinicalRecordOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :isEncounterOf ;
                    rdfs:domain :ClinicalRecord ;
                    rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isComplaintExamOf
:isComplaintExamOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isClinicalRecordOf ;
                   rdfs:domain :ComplaintExam ;
                   rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isConsultationOf
:isConsultationOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :isEncounterOf ;
                  rdfs:domain :Consultation ;
                  rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isCreatedByProvider
:isCreatedByProvider rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasProvider ;
                     rdfs:domain :ClinicalRecord ;
                     rdfs:range :Provider .


###  https://w3id.org/dhs/ontology#isDepartmentOf
:isDepartmentOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :relatesToDepartment ;
                rdfs:domain :Department .


###  https://w3id.org/dhs/ontology#isDiagnosisOf
:isDiagnosisOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isClinicalRecordOf ;
               rdfs:domain :Diagnosis ;
               rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isDispensedByProvider
:isDispensedByProvider rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasProvider ;
                       rdfs:domain :MedicationDispense ;
                       rdfs:range :Provider .


###  https://w3id.org/dhs/ontology#isEncounterOf
:isEncounterOf rdf:type owl:ObjectProperty .


###  https://w3id.org/dhs/ontology#isFacilityOf
:isFacilityOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :relatesToFacility ;
              rdfs:domain :Facility ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :Department
                                         :Provider
                                         :Referral
                                         :Transfer
                                       )
                         ] .


###  https://w3id.org/dhs/ontology#isHIVCareRecordOf
:isHIVCareRecordOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isClinicalAssessmentOf ;
                   rdfs:domain :HIVCareRecord ;
                   rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isHIVTestingRecordOf
:isHIVTestingRecordOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :isClinicalAssessmentOf ;
                      rdfs:domain :HIVTestingRecord ;
                      rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isLaboratoryResultOf
:isLaboratoryResultOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :isClinicalAssessmentOf ;
                      rdfs:domain :LaboratoryResult ;
                      rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isManagementPlanOf
:isManagementPlanOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :isClinicalRecordOf ;
                    rdfs:domain :ManagementPlan ;
                    rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isMaternalChildHealthRecordOf
:isMaternalChildHealthRecordOf rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf :isClinicalAssessmentOf ;
                               rdfs:domain :MaternalChildHealthRecord ;
                               rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isMaternalProfileOf
:isMaternalProfileOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :isClinicalRecordOf ;
                     rdfs:domain :MaternalProfile ;
                     rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isMedicationDispenseOf
:isMedicationDispenseOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :isEncounterOf ;
                        rdfs:domain :MedicationDispense ;
                        rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isMedicationOf
:isMedicationOf rdf:type owl:ObjectProperty ;
                rdfs:domain :Medication ;
                rdfs:range :MedicationDispense .


###  https://w3id.org/dhs/ontology#isMentalHealthAssessmentOf
:isMentalHealthAssessmentOf rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf :isClinicalAssessmentOf ;
                            rdfs:domain :MentalHealthAssessment ;
                            rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isNutritionAssessmentOf
:isNutritionAssessmentOf rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :isClinicalAssessmentOf ;
                         rdfs:domain :NutritionAssessment ;
                         rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isPatientFlowOf
:isPatientFlowOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :isEncounterOf ;
                 rdfs:domain :PatientFlow ;
                 rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isPatientIn
:isPatientIn rdf:type owl:ObjectProperty ;
             rdfs:domain :Patient ;
             rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isPerformedByProvider
:isPerformedByProvider rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasProvider ;
                       owl:inverseOf :performsConsultation ;
                       rdfs:domain :Consultation ;
                       rdfs:range :Provider .


###  https://w3id.org/dhs/ontology#isProviderOf
:isProviderOf rdf:type owl:ObjectProperty ;
              rdfs:domain :Provider ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :ClinicalAssessment
                                         :ClinicalRecord
                                         :Consultation
                                         :MedicationDispense
                                       )
                         ] .


###  https://w3id.org/dhs/ontology#isRecordedByProvider
:isRecordedByProvider rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasProvider ;
                      owl:inverseOf :recordsObservation ;
                      rdfs:domain :ClinicalAssessment ;
                      rdfs:range :Provider .


###  https://w3id.org/dhs/ontology#isReferralOf
:isReferralOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :isEncounterOf ;
              rdfs:domain :Referral ;
              rdfs:range :Visit .


###  https://w3id.org/dhs/ontology#isRehabilitationAssessmentOf
:isRehabilitationAssessmentOf rdf:type owl:ObjectProperty ;
