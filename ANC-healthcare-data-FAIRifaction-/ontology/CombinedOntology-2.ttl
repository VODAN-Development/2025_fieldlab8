                          rdfs:subPropertyOf :hasVitalSignsData ;
                          rdfs:domain :VitalSignsRecord ;
                          rdfs:range xsd:integer ;
                          skos:closeMatch <http://loinc.org/rdf/8480-6> .


###  https://w3id.org/dhs/ontology#hasTBScreeningData
:hasTBScreeningData rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :hasDataProperty .


###  https://w3id.org/dhs/ontology#hasTemperature
:hasTemperature rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :hasVitalSignsData ;
                rdfs:domain :TriageAssessment ;
                rdfs:range xsd:decimal ;
                skos:closeMatch <http://loinc.org/rdf/8310-5> .


###  https://w3id.org/dhs/ontology#hasTestName
:hasTestName rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :hasLaboratoryData ;
             rdfs:domain :LaboratoryResult ;
             rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasTestResult
:hasTestResult rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasLaboratoryData ;
               rdfs:domain :LaboratoryResult ;
               rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasTestType
:hasTestType rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :hasHIVTestingData ;
             rdfs:domain :HIVTestingRecord ;
             rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasTestedAt
:hasTestedAt rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :hasHIVTestingData ;
             rdfs:domain :HIVTestingRecord ;
             rdfs:range xsd:dateTime .


###  https://w3id.org/dhs/ontology#hasTransferData
:hasTransferData rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :hasDataProperty .


###  https://w3id.org/dhs/ontology#hasTransferInOut
:hasTransferInOut rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :hasHIVCareData ;
                  rdfs:domain :HIVCareRecord ;
                  rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasTransferReason
:hasTransferReason rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :hasTransferData ;
                   rdfs:domain :Transfer ;
                   rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasTransferStatus
:hasTransferStatus rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :hasTransferData ;
                   rdfs:domain :Transfer ;
                   rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasTransferTime
:hasTransferTime rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :hasTransferData ;
                 rdfs:domain :Transfer ;
                 rdfs:range xsd:dateTime .


###  https://w3id.org/dhs/ontology#hasTreatmentPlan
:hasTreatmentPlan rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :hasMentalHealthData ;
                  rdfs:domain :MentalHealthAssessment ;
                  rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasUPINumber
:hasUPINumber rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :hasIdentifier ;
              rdfs:domain :Patient ;
              rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasUnintendedWeightLoss
:hasUnintendedWeightLoss rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf :hasTBScreeningData ;
                         rdfs:domain :TBScreening ;
                         rdfs:range xsd:boolean .


###  https://w3id.org/dhs/ontology#hasUpdatedAt
:hasUpdatedAt rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :hasAuditData ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Department
                                          :Patient
                                          :Provider
                                          :Visit
                                        )
                          ] ;
              rdfs:range xsd:dateTime .


###  https://w3id.org/dhs/ontology#hasVDRLResult
:hasVDRLResult rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasHIVCareData ;
               rdfs:domain :HIVCareRecord ;
               rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasVillage
:hasVillage rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :hasAddressData ;
            rdfs:domain :Patient ;
            rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasVisitData
:hasVisitData rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :hasDataProperty .


###  https://w3id.org/dhs/ontology#hasVisitDate
:hasVisitDate rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :hasVisitData ;
              rdfs:domain :Visit ;
              rdfs:range xsd:date .


###  https://w3id.org/dhs/ontology#hasVisitId
:hasVisitId rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :hasIdentifier ;
            rdfs:domain :Visit ;
            rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasVisitTime
:hasVisitTime rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :hasVisitData ;
              rdfs:domain :Visit ;
              rdfs:range xsd:time .


###  https://w3id.org/dhs/ontology#hasVisitType
:hasVisitType rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :hasVisitData ;
              rdfs:domain :Visit ;
              rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasVitalSignsData
:hasVitalSignsData rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :hasDataProperty .


###  https://w3id.org/dhs/ontology#hasWard
:hasWard rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf :hasAddressData ;
         rdfs:domain :Patient ;
         rdfs:range xsd:string .


###  https://w3id.org/dhs/ontology#hasWasteDisposalMethod
:hasWasteDisposalMethod rdf:type owl:DatatypeProperty ;
                        rdfs:domain :EnvironmentalWASH ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Indicates the method used for household waste disposal." .


###  https://w3id.org/dhs/ontology#hasWaterSource
:hasWaterSource rdf:type owl:DatatypeProperty ;
                rdfs:domain :EnvironmentalWASH ;
                rdfs:range xsd:string ;
                rdfs:comment "Indicates the primary source of water available to a household." .


###  https://w3id.org/dhs/ontology#hasWeightKg
:hasWeightKg rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :hasVitalSignsData ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :NutritionAssessment
                                         :TriageAssessment
                                         :VitalSignsRecord
                                       )
                         ] ;
             rdfs:range xsd:decimal ;
             skos:closeMatch <http://loinc.org/rdf/29463-7> .


###  https://w3id.org/dhs/ontology#isActive
:isActive rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf :hasVisitData ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Department
                                      :Provider
                                      :Visit
                                    )
                      ] ;
          rdfs:range xsd:boolean .


###  https://w3id.org/dhs/ontology#requiresFollowUp
:requiresFollowUp rdf:type owl:DatatypeProperty ;
                  rdfs:domain :ServiceDelivery ;
                  rdfs:range xsd:boolean ;
                  rdfs:comment "Indicates whether additional follow-up care or monitoring is required after a service delivery activity." .


#################################################################
#    Classes
#################################################################

###  http://hl7.org/fhir/StructureDefinition/AllergyIntolerance
fhir:AllergyIntolerance rdf:type owl:Class .


###  http://hl7.org/fhir/StructureDefinition/CarePlan
fhir:CarePlan rdf:type owl:Class .


###  http://hl7.org/fhir/StructureDefinition/ClinicalImpression
fhir:ClinicalImpression rdf:type owl:Class .


###  http://hl7.org/fhir/StructureDefinition/CodeableConcept
fhir:CodeableConcept rdf:type owl:Class .


###  http://hl7.org/fhir/StructureDefinition/Composition
fhir:Composition rdf:type owl:Class .


###  http://hl7.org/fhir/StructureDefinition/Condition
fhir:Condition rdf:type owl:Class ;
               owl:equivalentClass :Diagnosis .


###  http://hl7.org/fhir/StructureDefinition/DocumentReference
fhir:DocumentReference rdf:type owl:Class .


###  http://hl7.org/fhir/StructureDefinition/Encounter
fhir:Encounter rdf:type owl:Class ;
               owl:equivalentClass :HealthcareEncounter .


###  http://hl7.org/fhir/StructureDefinition/Medication
fhir:Medication rdf:type owl:Class ;
                owl:equivalentClass :Medication .


###  http://hl7.org/fhir/StructureDefinition/MedicationDispense
fhir:MedicationDispense rdf:type owl:Class ;
                        owl:equivalentClass :MedicationDispense .


###  http://hl7.org/fhir/StructureDefinition/Observation
fhir:Observation rdf:type owl:Class .


###  http://hl7.org/fhir/StructureDefinition/Organization
fhir:Organization rdf:type owl:Class .


###  http://hl7.org/fhir/StructureDefinition/Patient
fhir:Patient rdf:type owl:Class ;
             owl:equivalentClass :Patient .


###  http://hl7.org/fhir/StructureDefinition/Person
fhir:Person rdf:type owl:Class ;
            owl:equivalentClass :Person .


###  http://hl7.org/fhir/StructureDefinition/Practitioner
fhir:Practitioner rdf:type owl:Class ;
                  owl:equivalentClass :Provider .


###  http://hl7.org/fhir/StructureDefinition/ServiceRequest
fhir:ServiceRequest rdf:type owl:Class .


###  http://hl7.org/fhir/StructureDefinition/vitalsigns
fhir:vitalsigns rdf:type owl:Class ;
                owl:equivalentClass :VitalSignsRecord .


###  https://w3id.org/dhs/ontology#AdministrativeWorkflow
:AdministrativeWorkflow rdf:type owl:Class ;
                        rdfs:comment "Administrative process related to patient management and healthcare operations"@en ;
                        rdfs:label "Administrative workflow"@en ;
                        skos:closeMatch "http://snomed.info/id/14734007"@en .


###  https://w3id.org/dhs/ontology#Admission
:Admission rdf:type owl:Class ;
           rdfs:subClassOf fhir:Encounter ,
                           :HealthcareEncounter ;
           rdfs:comment "Healthcare event representing an ANC patient admission into a healthcare facility."@en ;
           rdfs:label "Maternity admission"@en ;
           skos:closeMatch "http://snomed.info/id/32485007"@en .


###  https://w3id.org/dhs/ontology#Allergen
:Allergen rdf:type owl:Class ;
          rdfs:subClassOf fhir:AllergyIntolerance ,
                          :ReferenceTerminology ;
          rdfs:comment "Represents a substance that the immune system recognizes as foreign, triggering an IgE-mediated hypersensitivity reaction in sensitive individuals."@en ;
          rdfs:label "Allergen"@en ;
          skos:exactMatch "http://snomed.info/id/277054007"@en .


###  https://w3id.org/dhs/ontology#Allergy
:Allergy rdf:type owl:Class ;
         rdfs:subClassOf fhir:AllergyIntolerance ,
                         :ClinicalRecord ;
         rdfs:comment "Represents an allergy a person receiving healthcare services sufferes from."@en ;
         rdfs:label "Allergy"@en ;
         skos:exactMatch "http://snomed.info/id/722446000"@en .


###  https://w3id.org/dhs/ontology#BloodGroup
:BloodGroup rdf:type owl:Class ;
            rdfs:subClassOf fhir:Observation ,
                            :ReferenceTerminology ;
            rdfs:comment "Represents a blood type - A/B/AB/O."@en ;
            rdfs:label "Blood group"@en ;
            skos:closeMatch <http://loinc.org/rdf/883-9> ;
            skos:exactMatch "http://snomed.info/id/365636006"@en .


###  https://w3id.org/dhs/ontology#CHU_Referral
:CHU_Referral rdf:type owl:Class ;
              rdfs:comment "A documented request or transfer of an individual from a community healthcare provider to a healthcare facility or healthcare service for further assessment, diagnosis, treatment, or management."@en ;
              rdfs:label "CHU Referral"@en .


###  https://w3id.org/dhs/ontology#Client
:Client rdf:type owl:Class ;
        rdfs:comment "An individual registered within a household and receiving, eligible for, or participating in community healthcare services." ;
        rdfs:label "Client" .


###  https://w3id.org/dhs/ontology#ClinicalAssessment
:ClinicalAssessment rdf:type owl:Class ;
                    rdfs:subClassOf fhir:ClinicalImpression ,
                                    :ClinicalRecord ;
                    rdfs:comment "Assessment entity representing clinical observations and evaluations performed during healthcare delivery."@en ;
                    rdfs:label "Clinical Assessment"@en ;
                    skos:closeMatch "http://snomed.info/id/386637004"@en .


###  https://w3id.org/dhs/ontology#ClinicalNote
:ClinicalNote rdf:type owl:Class ;
              rdfs:subClassOf fhir:DocumentReference ,
                              :ClinicalRecord ;
              rdfs:comment "Clinical documentation containing notes recorded during patient care."@en ;
              rdfs:label "Clinical note"@en .


###  https://w3id.org/dhs/ontology#ClinicalRecord
:ClinicalRecord rdf:type owl:Class ;
                rdfs:subClassOf fhir:Composition ;
                rdfs:comment "Clinical information entity containing medical findings, diagnoses, assessments, and care documentation"@en ;
                rdfs:label "Clinical record"@en ;
                skos:exactMatch "http://snomed.info/id/371530004"@en .


###  https://w3id.org/dhs/ontology#CommunityHealthUnit
:CommunityHealthUnit rdf:type owl:Class ;
                     rdfs:comment "A geographically defined community-based health service unit responsible for coordinating and delivering primary healthcare services to households within a designated population." ;
                     rdfs:label "Community Health Unit" .


###  https://w3id.org/dhs/ontology#ComplaintExam
:ComplaintExam rdf:type owl:Class ;
               rdfs:subClassOf :ClinicalRecord ;
               rdfs:comment "Clinical record containing presenting complaints, physical examination findings, and remarks."@en ;
               rdfs:label "Complaint Exam"@en ;
               skos:closeMatch "http://snomed.info/id/185349003"@en ,
                               "http://snomed.info/id/302199004"@en .


###  https://w3id.org/dhs/ontology#Consultation
:Consultation rdf:type owl:Class ;
              rdfs:subClassOf fhir:Encounter ,
                              :HealthcareEncounter ;
              rdfs:comment "Healthcare event representing an interaction between a patient and healthcare provider for clinical consultation."@en ;
              rdfs:label "Consultation"@en ;
              skos:exactMatch "http://snomed.info/id/11429006"@en .


###  https://w3id.org/dhs/ontology#Department
:Department rdf:type owl:Class ;
            rdfs:subClassOf fhir:Organization ,
                            :HealthcareEntity ;
            rdfs:comment "Organizational unit within a healthcare facility responsible for providing specific healthcare services." ;
            rdfs:label "Department"@en ;
            skos:exactMatch "http://snomed.info/id/309912009"@en .


###  https://w3id.org/dhs/ontology#DepartmentType
:DepartmentType rdf:type owl:Class ;
                rdfs:subClassOf fhir:Organization ,
                                :ReferenceTerminology ;
                rdfs:comment "Type of organizational unit within a healthcare facility responsible for providing specific healthcare services." ;
                rdfs:label "Department Type"@en .


###  https://w3id.org/dhs/ontology#Diagnosis
:Diagnosis rdf:type owl:Class ;
           rdfs:subClassOf :ClinicalRecord ;
           rdfs:comment "Represents a working or a final diagnosis of a patient."@en ;
           rdfs:label "Diagnosis"@en ;
           skos:exactMatch "http://snomed.info/id/439401001"@en .


###  https://w3id.org/dhs/ontology#DiagnosisType
:DiagnosisType rdf:type owl:Class ;
               rdfs:comment "Represents the category or type of a diagnosis."@en ;
               rdfs:label "Diagnosis Type"@en ;
               skos:exactMatch "http://snomed.info/id/106229004"@en .


###  https://w3id.org/dhs/ontology#EnvironmentalWASH
:EnvironmentalWASH rdf:type owl:Class ;
                   rdfs:comment "A record describing environmental, water, sanitation, hygiene, and waste management conditions associated with a household and relevant to community health." ;
                   rdfs:label "Environmental and WASH Assessment" .


###  https://w3id.org/dhs/ontology#Facility
:Facility rdf:type owl:Class ;
          rdfs:subClassOf fhir:Organization ,
                          :HealthcareEntity ;
          rdfs:comment "Healthcare institution where healthcare services are delivered."@en ;
          rdfs:label "Facility"@en ;
          skos:exactMatch "http://snomed.info/id/257622000"@en .


###  https://w3id.org/dhs/ontology#Gender
:Gender rdf:type owl:Class ;
        rdfs:subClassOf :ReferenceTerminology ;
        rdfs:label "Gender"@en .


###  https://w3id.org/dhs/ontology#HIVCareRecord
:HIVCareRecord rdf:type owl:Class ;
               rdfs:subClassOf fhir:Condition ,
                               :ClinicalAssessment ;
               rdfs:comment "Observation record related to HIV care, treatment status, and follow-up information."@en ;
               rdfs:label "HIV Care Record"@en ;
               skos:closeMatch "http://snomed.info/id/24091000087107"@en .


###  https://w3id.org/dhs/ontology#HIVStatus
:HIVStatus rdf:type owl:Class ;
           rdfs:subClassOf fhir:Observation ,
                           :ReferenceTerminology ;
           rdfs:comment "Observation record documenting HIV status assessment."@en ;
           rdfs:label "HIV Status"@en ;
           skos:closeMatch <http://loinc.org/rdf/55277-8> ;
           skos:exactMatch "http://snomed.info/id/278977008"@en .


###  https://w3id.org/dhs/ontology#HIVTestingRecord
:HIVTestingRecord rdf:type owl:Class ;
                  rdfs:subClassOf fhir:Observation ,
                                  :ClinicalAssessment ;
                  rdfs:comment "Observation record documenting HIV testing procedures and results."@en ;
                  rdfs:label "HIV Testing Record"@en ;
                  skos:exactMatch "http://snomed.info/id/171121004"@en .


###  https://w3id.org/dhs/ontology#HealthSurveillance
:HealthSurveillance rdf:type owl:Class ;
                    rdfs:comment "A record of observed health conditions, symptoms, risk factors, health status indicators, or disease-related information collected for monitoring the health of an individual." ;
                    rdfs:label "Health Surveillance" .


###  https://w3id.org/dhs/ontology#HealthcareEncounter
:HealthcareEncounter rdf:type owl:Class ;
                     rdfs:comment "Event occurring during healthcare delivery or patient care processes."@en ;
                     rdfs:label "Healthcare encounter"@en ;
                     skos:exactMatch "http://snomed.info/id/308335008"@en .


###  https://w3id.org/dhs/ontology#HealthcareEntity
:HealthcareEntity rdf:type owl:Class ;
                  rdfs:subClassOf fhir:Organization ;
                  rdfs:comment "General entity representing organizational or structural healthcare resources."@en ;
                  rdfs:label "Healthcare entity"@en .


###  https://w3id.org/dhs/ontology#HouseholdRegistration
:HouseholdRegistration rdf:type owl:Class ;
                       rdfs:comment "A record documenting the registration of a household within a Community Health Unit, including household location, membership, and administrative information." ;
                       rdfs:label "Household Registration" .


###  https://w3id.org/dhs/ontology#ICDCode
:ICDCode rdf:type owl:Class ;
         rdfs:subClassOf fhir:CodeableConcept ;
         rdfs:comment "Represents a code from the International Classification of Diseases (ICD)."@en ;
         rdfs:label "ICD Code"@en .


###  https://w3id.org/dhs/ontology#LaboratoryResult
:LaboratoryResult rdf:type owl:Class ;
                  rdfs:subClassOf fhir:Observation ,
                                  :ClinicalAssessment ;
                  rdfs:comment "Observation representing laboratory tests and their results."@en ;
                  rdfs:label "Laboratory result"@en ;
                  skos:exactMatch "http://snomed.info/id/275924004"@en .


###  https://w3id.org/dhs/ontology#ManagementPlan
:ManagementPlan rdf:type owl:Class ;
                rdfs:subClassOf fhir:CarePlan ,
                                :ClinicalRecord ;
                rdfs:comment "Clinical record describing planned investigations, medications, counselling, and follow-up care."@en ;
                rdfs:label "Management plan"@en ;
                skos:closeMatch <http://loinc.org/rdf/18776-5> ;
                skos:exactMatch "http://snomed.info/id/734163000"@en .


###  https://w3id.org/dhs/ontology#MaternalChildHealth
:MaternalChildHealth rdf:type owl:Class ;
                     rdfs:comment "A record containing information related to maternal and child health, including pregnancy status, antenatal care, delivery, postnatal care, child immunization, and growth monitoring." ;
                     rdfs:label "Maternal and Child Health" .


###  https://w3id.org/dhs/ontology#MaternalChildHealthRecord
:MaternalChildHealthRecord rdf:type owl:Class ;
                           rdfs:subClassOf fhir:Composition ,
                                           :ClinicalAssessment ;
                           rdfs:comment "Observation record related to maternal and child healthcare services."@en ;
                           rdfs:label "Maternal and child health record"@en ;
                           skos:closeMatch <http://loinc.org/rdf/57073-9> ,
                                           "http://snomed.info/id/406199001"@en .


###  https://w3id.org/dhs/ontology#MaternalProfile
:MaternalProfile rdf:type owl:Class ;
                 rdfs:subClassOf fhir:Patient ,
                                 :ClinicalRecord ;
                 rdfs:comment "Clinical record containing maternal health and pregnancy-related information."@en ;
                 rdfs:label "Maternal profile"@en ;
                 skos:closeMatch "https://profiles.ihe.net/PCC/mAPS/StructureDefinition-IHE.PregnancyHistory.html"@en ;
                 skos:exactMatch "http://snomed.info/id/246104002"@en .


###  https://w3id.org/dhs/ontology#Medication
:Medication rdf:type owl:Class ;
            rdfs:comment "Entity representing medication prescribed or dispensed to a patient."@en ;
            rdfs:label "Medication"@en ;
            skos:closeMatch "http://snomed.info/id/182833002"@en .


###  https://w3id.org/dhs/ontology#MedicationDispense
:MedicationDispense rdf:type owl:Class ;
                    rdfs:subClassOf :HealthcareEncounter ;
                    rdfs:comment "Record representing the dispensing of medication to a patient."@en ;
                    rdfs:label "Medication dispense"@en ;
                    skos:closeMatch "http://snomed.info/id/373784005"@en .


###  https://w3id.org/dhs/ontology#MentalHealthAssessment
:MentalHealthAssessment rdf:type owl:Class ;
                        rdfs:subClassOf :ClinicalAssessment ;
                        rdfs:comment "Observation representing mental health evaluation, assessment notes, and treatment planning."@en ;
                        rdfs:label "Mental health assessment"@en ;
                        skos:exactMatch "http://snomed.info/id/401061005"@en .


###  https://w3id.org/dhs/ontology#NutritionAssessment
:NutritionAssessment rdf:type owl:Class ;
                     rdfs:subClassOf :ClinicalAssessment ;
                     rdfs:comment "Observation related to nutritional status and malnutrition assessment."@en ;
                     rdfs:label "Nutrition assessment"@en ;
                     skos:exactMatch "http://snomed.info/id/1759002"@en .


###  https://w3id.org/dhs/ontology#Patient
:Patient rdf:type owl:Class ;
         rdfs:subClassOf :Person ;
         rdfs:comment "Represents a person receiving healthcare services."@en ;
         rdfs:label "Patient"@en ;
         skos:exactMatch "http://snomed.info/id/116154003"@en .


###  https://w3id.org/dhs/ontology#PatientFlow
:PatientFlow rdf:type owl:Class ;
             rdfs:subClassOf :AdministrativeWorkflow ;
             rdfs:comment "Administrative workflow following patient movement through healthcare services or departments."@en ;
             rdfs:label "Patient flow"@en .


###  https://w3id.org/dhs/ontology#Person
:Person rdf:type owl:Class ;
        rdfs:comment "Human individual"@en ;
        rdfs:label "Person"@en .


###  https://w3id.org/dhs/ontology#Provider
:Provider rdf:type owl:Class ;
          rdfs:subClassOf :Person ;
          rdfs:comment "Represents a person providing healthcare services."@en ;
          rdfs:label "Healthcare provider"@en ;
          skos:exactMatch "http://snomed.info/id/223366009"@en .


###  https://w3id.org/dhs/ontology#ReferenceTerminology
:ReferenceTerminology rdf:type owl:Class ;
                      rdfs:comment "A standardized terminology or coding system used to represent 				clinical concepts in healthcare."@en ;
                      rdfs:label "Reference Terminology"@en .


###  https://w3id.org/dhs/ontology#Referral
:Referral rdf:type owl:Class ;
          rdfs:subClassOf fhir:ServiceRequest ,
                          :HealthcareEncounter ;
          rdfs:comment "Healthcare event representing referral of a patient between providers, departments, or facilities."@en ;
          rdfs:label "Referral"@en ;
          skos:exactMatch "http://snomed.info/id/3457005"@en .


###  https://w3id.org/dhs/ontology#RehabilitationAssessment
:RehabilitationAssessment rdf:type owl:Class ;
                          rdfs:subClassOf :ClinicalAssessment ;
                          rdfs:comment "Observation related to rehabilitation services, assessments, and rehabilitation planning."@en ;
                          rdfs:label "Rehabilitation assessments"@en ;
                          skos:closeMatch "http://snomed.info/id/52052004"@en ;
                          skos:exactMatch "http://snomed.info/id/410081009"@en .


###  https://w3id.org/dhs/ontology#RhesusFactor
:RhesusFactor rdf:type owl:Class ;
              rdfs:subClassOf fhir:Observation ,
                              :ReferenceTerminology ;
              rdfs:comment "Observation record documenting Rhesus Factor assessment."@en ;
              rdfs:label "Rhesus Factor"@en ;
