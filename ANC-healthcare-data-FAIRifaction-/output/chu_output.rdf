  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#RhesusFactor">
    <skos:closeMatch rdf:resource="http://loinc.org/rdf/10331-7"/>
    <rdfs:label xml:lang="en">Rhesus Factor</rdfs:label>
    <skos:exactMatch xml:lang="en">http://snomed.info/id/278155008</skos:exactMatch>
    <rdfs:comment xml:lang="en">Observation record documenting Rhesus Factor assessment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#EnvironmentalWASH">
    <rdfs:label>Environmental and WASH Assessment</rdfs:label>
    <rdfs:comment>A record describing environmental, water, sanitation, hygiene, and waste management conditions associated with a household and relevant to community health.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#Admission">
    <skos:closeMatch xml:lang="en">http://snomed.info/id/32485007</skos:closeMatch>
    <rdfs:label xml:lang="en">Maternity admission</rdfs:label>
    <rdfs:comment xml:lang="en">Healthcare event representing an ANC patient admission into a healthcare facility.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#Female">
    <skos:exactMatch xml:lang="en">http://snomed.info/id/1086007</skos:exactMatch>
    <rdf:type rdf:resource="https://w3id.org/dhs/ontology#ReferenceTerminology"/>
    <rdf:type rdf:resource="https://w3id.org/dhs/ontology#Gender"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#CommunityHealthUnit">
    <rdfs:label>Community Health Unit</rdfs:label>
    <rdfs:comment>A geographically defined community-based health service unit responsible for coordinating and delivering primary healthcare services to households within a designated population.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasMaternalChildHealth">
    <rdfs:label>has maternal and child health record</rdfs:label>
    <rdfs:comment>Relates a client to a maternal and child health record containing pregnancy, antenatal, delivery, postnatal, immunization, or growth monitoring information.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#RhesusNegative">
    <skos:exactMatch rdf:resource="http://snomed.info/id/165746003"/>
    <rdf:type rdf:resource="https://w3id.org/dhs/ontology#RhesusFactor"/>
    <rdf:type rdf:resource="https://w3id.org/dhs/ontology#ReferenceTerminology"/>
    <rdf:type rdf:resource="http://hl7.org/fhir/StructureDefinition/Observation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#HIVNegative">
    <skos:exactMatch rdf:resource="http://snomed.info/id/165815009"/>
    <rdf:type rdf:resource="https://w3id.org/dhs/ontology#ReferenceTerminology"/>
    <rdf:type rdf:resource="http://hl7.org/fhir/StructureDefinition/Observation"/>
    <rdf:type rdf:resource="https://w3id.org/dhs/ontology#HIVStatus"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasHouseholdVillage">
    <rdfs:comment>Relates a household registration record to the village in which the household is located.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#FinalDiagnosis">
    <skos:exactMatch rdf:resource="http://snomed.info/id/89100005"/>
    <rdf:type rdf:resource="https://w3id.org/dhs/ontology#DiagnosisType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasLatrineAvailable">
    <rdfs:comment>Indicates whether a household has access to a latrine.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasPregnancyStatus">
    <rdfs:comment>Indicates whether an individual is recorded as pregnant.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#HIVCareRecord">
    <skos:closeMatch xml:lang="en">http://snomed.info/id/24091000087107</skos:closeMatch>
    <rdfs:label xml:lang="en">HIV Care Record</rdfs:label>
    <rdfs:comment xml:lang="en">Observation record related to HIV care, treatment status, and follow-up information.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#O48">
    <rdf:type rdf:resource="https://w3id.org/dhs/ontology#ICDCode"/>
    <rdf:type rdf:resource="http://hl7.org/fhir/StructureDefinition/CodeableConcept"/>
    <skos:closeMatch xml:lang="en">http://snomed.info/id/90968009</skos:closeMatch>
    <rdfs:label xml:lang="en">Prolonged pregnancy</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasChronicCondition">
    <rdfs:comment>Indicates a chronic health condition recorded for an individual.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#ServiceDelivery">
    <rdfs:label>Service Delivery</rdfs:label>
    <rdfs:comment>A healthcare service or intervention delivered by a Community Health Practitioner to an individual within a community setting, including health education, screening, treatment, and follow-up activities.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasPostnatalVisits">
    <rdfs:comment>Indicates the number of postnatal care visits recorded after delivery.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasDangerSigns">
    <rdfs:comment>Indicates warning signs or clinical indicators requiring additional assessment or intervention.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasHeightCm">
    <skos:closeMatch rdf:resource="http://loinc.org/rdf/8302-2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#Allergy">
    <rdfs:label xml:lang="en">Allergy</rdfs:label>
    <skos:exactMatch xml:lang="en">http://snomed.info/id/722446000</skos:exactMatch>
    <rdfs:comment xml:lang="en">Represents an allergy a person receiving healthcare services sufferes from.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasCHUCounty">
    <rdfs:comment>Relates a Community Health Unit to the county in which it operates.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasEnvironmentalWASH">
    <rdfs:label>has environmental and WASH assessment</rdfs:label>
    <rdfs:comment>Relates a household registration record to an environmental, water, sanitation, hygiene, and waste management assessment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasSurveillanceNutritionStatus">
    <rdfs:comment>Indicates the nutritional status recorded for an individual.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasClientDisabilityStatus">
    <rdfs:comment>Indicates whether a client has a recorded disability status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#Gender">
    <rdfs:label xml:lang="en">Gender</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasCHUName">
    <rdfs:comment>Relates a Community Health Unit to its official name.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasHouseholdID">
    <rdfs:comment>Relates a household registration record to its unique household identifier.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasReferralType">
    <rdfs:comment>Indicates the category or type of referral issued.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasProgramArea">
    <rdfs:comment>Indicates the healthcare program area associated with the service delivery activity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasCHUWard">
    <rdfs:comment>Relates a Community Health Unit to the administrative ward in which it is located.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasReasonForReferral">
    <rdfs:comment>Indicates the clinical or administrative reason for issuing a referral.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasServiceDeliveryDate">
    <rdfs:comment>Indicates the date on which a community healthcare service was delivered.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasSanitationType">
    <rdfs:comment>Indicates the sanitation facilities available to a household.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasSymptom">
    <rdfs:comment>Indicates a symptom observed or reported for an individual.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasAge">
    <rdfs:comment>Indicates the age of a client.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasHeartRate">
    <skos:closeMatch rdf:resource="http://loinc.org/rdf/8867-4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasChildImmunizationStatus">
    <rdfs:comment>Indicates the immunization status recorded for a child.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasSystolicBloodPressure">
    <skos:closeMatch rdf:resource="http://loinc.org/rdf/8480-6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasWeightKg">
    <skos:closeMatch rdf:resource="http://loinc.org/rdf/29463-7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasCHUReferralDate">
    <rdfs:comment>Indicates the date on which a referral was issued.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasDateRegistered">
    <rdfs:comment>Indicates the date on which the household was registered.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasTemperature">
    <skos:closeMatch rdf:resource="http://loinc.org/rdf/8310-5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasImmunizationStatus">
    <rdfs:comment>Indicates the immunization status recorded for an individual.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasCHUSubCounty">
    <rdfs:comment>Relates a Community Health Unit to the sub-county in which it operates.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasHouseholdRegistration">
    <rdfs:label>has household registration</rdfs:label>
    <rdfs:comment>Relates a Community Health Unit to a household registration record within its area of responsibility.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasHouseholdHeadName">
    <rdfs:comment>Relates a household registration record to the name of the household head.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dhs/ontology#hasFullName">
    <rdfs:comment>Relates a client to their full name.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
